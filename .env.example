# Opcional: Cloudinary para uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pet-c3

# Opcional: email/notificacoes
